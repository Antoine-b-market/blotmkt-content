  <script>
    (function(){
      var headings=document.querySelectorAll('.article-col h2');
      var toc=document.getElementById('toc-list');
      var idx=0;
      headings.forEach(function(h){
        if(h.closest('.related')) return;
        if(h.closest('blockquote')) return;
        var id=h.id||'heading-'+(idx++);
        h.id=id;
        var li=document.createElement('li');
        var a=document.createElement('a');
        a.href='#'+id;a.textContent=h.textContent;
        li.appendChild(a);toc.appendChild(li);
      });
      var links=toc.querySelectorAll('a');
      window.addEventListener('scroll',function(){
        var pos=window.scrollY+80;var active=null;
        headings.forEach(function(h){if(h.offsetTop<=pos)active=h.id;});
        links.forEach(function(a){a.classList.toggle('active',a.getAttribute('href')==='#'+active);});
      });
    })();
  </script>
